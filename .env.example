# ---- Public address -------------------------------------------------------
# No trailing slash. Must exactly match the origin you browse to, because the
# Google OAuth redirect URI is derived from it.
#
# The hostname Caddy serves is NOT set here — it lives in the shared proxy at
# infra/sites/toolhub.caddy. Keep the two in agreement.
APP_URL=https://tools.example.com

# ---- Google OAuth ---------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorised redirect URI must be: ${APP_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google accounts allowed to sign in. Everyone else is refused.
ALLOWED_EMAILS=you@gmail.com

# ---- Session --------------------------------------------------------------
# Encrypts the session cookie. At least 32 characters.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ---- Downloader -----------------------------------------------------------
# Owner for downloaded files. Must be YOUR uid/gid, which is not necessarily
# 1000 — on Oracle's Ubuntu image uid 1000 is `opc` and `ubuntu` is 1001.
# Check with: id -u && id -g
PUID=1000
PGID=1000

# Internal address of the MeTube container. Leave unset to disable the tool
# gracefully — the rest of the toolhub keeps working.
METUBE_URL=http://metube:8081

# ---- Optional -------------------------------------------------------------
# Fallback for public playlists only; private ones always need OAuth.
YOUTUBE_API_KEY=

# Override the image the server runs. Defaults to the :latest tag pushed by CI;
# set a commit-SHA tag here to pin or roll back.
# TOOLHUB_IMAGE=ghcr.io/rauhan-sheikh/toolhub:latest
