{$APP_DOMAIN} {
	encode zstd gzip

	# Caddy obtains and renews the TLS certificate automatically, provided the
	# domain's A record points here and ports 80/443 are reachable.
	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	log {
		output stdout
		format console
	}
}
